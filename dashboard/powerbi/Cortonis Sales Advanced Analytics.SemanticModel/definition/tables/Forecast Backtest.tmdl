/// Module 3 — 2020 backtest: actual vs historical-mean / seasonal-naive / Prophet, with APE per method.
table 'Forecast Backtest'
	lineageTag: 3278ec40-e578-4e06-ba86-e5c2c4e0cd94

	column ds
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: 9c76fa86-2001-4486-b3ba-1fd1707c22bb
		summarizeBy: none
		sourceColumn: ds

	column 'Product Class'
		dataType: string
		lineageTag: d52d33c9-d5b2-44a9-9765-483bbbfa7376
		summarizeBy: none
		sourceColumn: Product Class

	column y
