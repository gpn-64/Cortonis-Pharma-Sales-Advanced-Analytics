		summarizeBy: sum
		sourceColumn: y

	column yhat_mean
		dataType: double
		formatString: #,0
		lineageTag: b48f3b96-5f94-4742-a737-0a5bf86106ed
		summarizeBy: sum
		sourceColumn: yhat_mean

	column yhat_naive
