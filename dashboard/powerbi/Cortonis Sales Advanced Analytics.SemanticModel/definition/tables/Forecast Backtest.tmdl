	partition 'Forecast Backtest' = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Users\User\Documents\Coding Projects\Cortonis-Pharma-Sales-Advanced-Analytics\results\generated\sales_forecast_backtest.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Typed = Table.TransformColumnTypes(Promoted, {{"ds", type datetime}, {"Product Class", type text}, {"y", type number}, {"yhat_mean", type number}, {"yhat_naive", type number}, {"yhat_prophet", type number}, {"yhat_lower", type number}, {"yhat_upper", type number}, {"ape_yhat_mean", type number}, {"ape_yhat_naive", type number}, {"ape_yhat_prophet", type number}})
				in
				  Typed

