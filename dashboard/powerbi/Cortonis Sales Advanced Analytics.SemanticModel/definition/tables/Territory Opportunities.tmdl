	partition 'Territory Opportunities' = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Users\User\Documents\Coding Projects\Cortonis-Pharma-Sales-Advanced-Analytics\results\generated\territory_opportunities.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				  Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				  Typed = Table.TransformColumnTypes(Promoted, {{"City", type text}, {"Country", type text}, {"RegionCanonical", type text}, {"Population", type number}, {"MonthlySales", type number}, {"Residual", type number}, {"Channel", type text}})
				in
				  Typed

